<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="18dp"
    android:paddingTop="24dp"
    android:paddingEnd="18dp"
    android:paddingBottom="28dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:src="@drawable/ic_fileflow" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/navy" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/tagline" android:textColor="@color/secondary_text" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonRecent" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/recent" android:textAllCaps="false" app:backgroundTint="@color/surface" app:cornerRadius="14dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonSettings" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/settings" android:textAllCaps="false" app:backgroundTint="@color/surface" app:cornerRadius="14dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="310dp" android:layout_marginTop="22dp" android:background="@drawable/bg_hero" android:gravity="bottom" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/private_by_design" android:textColor="@color/blue_primary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/hero_title" android:textColor="@color/navy" android:textSize="34sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/hero_subtitle" android:textColor="@color/secondary_text" android:textSize="17sp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" android:text="@string/available_now" android:textColor="@color/navy" android:textSize="20sp" android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImageCompressor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/ic_fileflow" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/image_compressor" android:textColor="@color/navy" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/compress_description" android:textColor="@color/secondary_text" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/more_symbol" android:textColor="@color/blue_primary" android:textSize="30sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPdfExcel" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/pdf_to_excel" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPdfWord" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="@string/pdf_to_word" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonWordPdf" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="@string/word_to_pdf" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPdfCompress" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="@string/pdf_compressor" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPdfEditor" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="@string/pdf_editor" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonImagePdf" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="@string/image_to_pdf" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonImageConvert" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="@string/image_converter" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonScanner" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="@string/document_scanner" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPrepare" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="9dp" android:text="@string/prepare_upload" android:textAllCaps="false" android:textSize="15sp" app:backgroundTint="@color/surface" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_upload" android:padding="16dp" android:text="@string/native_limitations" android:textColor="@color/secondary_text" android:textSize="12sp" />
        <FrameLayout android:id="@+id/adContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
