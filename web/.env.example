# Optional browser accounts. Leave unset for basic local and service tools.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development: leave blank; Vite proxies /api/v1 to localhost:8080.
# Production: REQUIRED for service tools unless you configure your own API proxy.
# Set https://YOUR-BACKEND-HOST/api/v1 in Vercel, then rebuild/redeploy the web app.
# Vercel serves this React client; it does not run the Spring Boot / LibreOffice worker.
VITE_PROCESSING_API_URL=
