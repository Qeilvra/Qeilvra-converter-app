# Optional browser accounts. Leave unset for account-free local tools.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional office renderer for Word-to-PDF. Keep blank for fully local tools.
# There is no automatic document upload or fallback to /api/v1.
# Keep blank for Vercel-only use. A separately operated worker can still expose
# the repository's API. The Word-to-PDF screen shows an unchecked upload option
# only when this is set. Selecting it sends this file to the displayed URL.
VITE_PROCESSING_API_URL=
